    {
      "parameters": {
        "jsCode": "// 1. Capturamos el texto bruto\nlet rawText = $input.first().json?.content?.parts?.[0]?.text || $input.first().json?.text;\nrawText = rawText.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\n// 2. Convertimos a Objeto JSON\nconst respuestaIA = JSON.parse(rawText);\nconst resumen = respuestaIA.resumen;\n\n// 3. Construimos el CSV para Anki\nlet csvText = \"Pregunta|Respuesta\\n\";\nrespuestaIA.flashcards.forEach(card => {\n    csvText += `${card.pregunta}|${card.respuesta}\\n`;\n});\n\n// 4. Nombres de los archivos\nconst baseName = \"Apuntes_\" + new Date().toISOString().split('T')[0];\nconst csvFileName = baseName + \"_Flashcards.csv\";\nconst htmlFileName = baseName + \"_Resumen.html\";\n\n// 5. HTML elegante para el resumen\nconst htmlContent = `\n<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Resumen de Estudio</title>\n    <style>\n        body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f4f7f6; color: #333; line-height: 1.6; padding: 40px; }\n        .container { max-width: 800px; margin: 0 auto; background: #fff; padding: 40px 50px; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.08); border-top: 6px solid #1a73e8; }\n        h1 { color: #1a73e8; font-size: 26px; border-bottom: 2px solid #f0f0f0; padding-bottom: 12px; margin-top: 0;}\n        p { font-size: 16px; text-align: justify; }\n        .footer { margin-top: 40px; font-size: 13px; color: #aaa; text-align: center; font-style: italic; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>📚 Resumen del Tema</h1>\n        <p>${resumen}</p>\n        <div class=\"footer\">Generado automáticamente con n8n y Google Gemini 🤖</div>\n    </div>\n</body>\n</html>\n`;\n\n// 6. Creamos los binarios limpios\nconst csvBinaryRaw = await this.helpers.prepareBinaryData(Buffer.from(csvText), csvFileName, 'text/csv');\nconst htmlBinaryRaw = await this.helpers.prepareBinaryData(Buffer.from(htmlContent), htmlFileName, 'text/html');\n\n// 7. Devolvemos la salida (añadiendo el texto HTML)\nreturn [{\n    json: {\n        resumen: resumen,\n        htmlPuro: htmlContent // Añadimos el HTML en texto aquí\n    },\n    binary: {\n        data: csvBinaryRaw,          \n        resumenHtml: htmlBinaryRaw   \n    }\n}];"
      },
